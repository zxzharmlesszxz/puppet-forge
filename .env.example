APP_ENV=dev
LOG_LEVEL=info
HTTP_ADDR=:8080
METRICS_ADDR=:9090
READ_HEADER_TIMEOUT=10s
READ_TIMEOUT=0s
WRITE_TIMEOUT=0s
IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
SHUTDOWN_TIMEOUT=10s

DATABASE_DSN=postgres://forge:forge@postgres:5432/forge?sslmode=disable
# Development-only bootstrap/break-glass admin token. Use it to open /manage on a fresh DB and replace it for every real deployment.
ADMIN_TOKEN=replace-me
# Required server-side pepper for access-token hashes. Use the same random value of at least 32 bytes on every replica.
ACCESS_TOKEN_PEPPER=replace-with-at-least-32-random-bytes
# Required independent hash key for opaque /manage session IDs. Keep it stable and identical on every replica.
MANAGE_SESSION_SECRET=replace-with-a-different-32-byte-secret
ACCESS_TOKEN_HISTORY_TTL=2160h
DELETED_RELEASE_TTL=2160h
ARTIFACT_BACKEND=gcs
ARTIFACT_ENDPOINT=https://storage.googleapis.com
ARTIFACT_BUCKET=puppet-forge-artifacts
ARTIFACT_PROJECT=my-gcp-project
ARTIFACT_ENSURE_BUCKET=false
ARTIFACT_PREFIX=modules
ARTIFACT_REGION=us-east-1
ARTIFACT_ACCESS_KEY_ID=
ARTIFACT_SECRET_ACCESS_KEY=
ARTIFACT_PATH_STYLE=true
# Optional fallback. Leave empty to derive external URLs from Host/Forwarded/X-Forwarded-*.
PUBLIC_BASE_URL=
# Optional comma- or space-separated allowlist for externally visible request hosts.
ALLOWED_PUBLIC_HOSTS=
# Forwarded headers are ignored unless this is true and the immediate proxy is covered by TRUSTED_PROXY_CIDRS.
TRUST_FORWARDED_HEADERS=false
# Comma- or space-separated ingress/reverse-proxy CIDRs trusted to set X-Forwarded-For.
TRUSTED_PROXY_CIDRS=
PUBLIC_MODULE_ACCESS=false
ACTIVE_RELEASE_TTL=720h
SECURITY_HSTS_ENABLED=false
WEB_AUTH_MODE=none
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional. Leave empty to derive from the current request URL and append /auth/callback.
OIDC_REDIRECT_URL=
# Optional. Auto-discovered from OIDC end_session_endpoint when provider exposes it.
OIDC_LOGOUT_URL=
OIDC_COOKIE_SECRET=
# Space-separated asymmetric ID-token signing algorithms accepted from the provider.
OIDC_SIGNING_ALGORITHMS=RS256
# Add provider-specific scopes such as groups when required. openid is always requested.
OIDC_SCOPES=openid profile email
UPSTREAM_URL=https://forgeapi.puppetlabs.com
UPSTREAM_PROXY_JSON_CACHE_TTL=5m
UPSTREAM_PROXY_JSON_STALE_TTL=1h
FORGE_CACHE_MAX_BODY_BYTES=1048576
MODULE_UPLOAD_MAX_BYTES=134217728
UPSTREAM_ARTIFACT_MAX_BYTES=134217728
UPSTREAM_ARTIFACT_ORPHAN_TTL=24h
UPSTREAM_SYNC_INTERVAL=0s
UPSTREAM_SYNC_LIMIT=1000
UPSTREAM_SYNC_CONCURRENCY=8
METRICS_MODULE_LIMIT=10000
METRICS_REFRESH_INTERVAL=30s
RECONCILE_ARTIFACTS=false
RECONCILE_REPAIR=false
