{{template "layout" .}}

{{define "page-title"}}Add Team{{end}}

{{define "page-styles"}}
<!--suppress HtmlUnknownTarget -->
<link rel="stylesheet" href="/assets/manage-access-add-team.css">
{{end}}

{{define "page-content"}}
{{template "page-header" .}}
{{template "notices" (notices "" .Error)}}
<section class="panel content-panel">
  <form method="post" action="/manage/teams/new">
    {{csrfInput $.CSRFToken}}
    <input type="hidden" name="action" value="save_team">
    <div class="team-name-field">
      <label for="new-team">Team</label>
      <input id="new-team" name="team" placeholder="Platform" pattern="[A-Za-z0-9]+" required>
    </div>
    {{template "team-access-fields" (teamAccessFields "new" "" "" "" "")}}
    <div class="button-row">
      <button type="submit">Add Team</button>
    </div>
  </form>
</section>
{{end}}
