{{template "layout" .}}
{{define "page-title"}}Moderation{{end}}
{{define "page-styles"}}<link rel="stylesheet" href="/assets/manage-force-delete.css">{{end}}
{{define "page-content"}}
{{template "page-header" .}}
<section class="panel content-panel compact-fields">
  <dl class="resource">
    <dt>Resource</dt><dd><code>{{.Resource}}</code></dd>
    <dt>Status</dt><dd>{{.Status.State}}</dd>
    {{if .SHA256}}<dt>SHA256</dt><dd><code>{{.SHA256}}</code></dd>{{end}}
    {{if .Status.Reason}}<dt>Reason</dt><dd>{{.Status.Reason}}</dd>{{end}}
    {{if .Status.Replacement}}<dt>Replacement</dt><dd>{{.Status.Replacement}}</dd>{{end}}
  </dl>
  {{if .DownloadURL}}<p><a class="button" href="{{.DownloadURL}}" download>Download archive</a></p>{{end}}
  <form method="post">
    {{csrfInput .CSRFToken}}
    <input type="hidden" name="sha256" value="{{.SHA256}}">
    <label>Decision<select name="action" required>{{range .Actions}}<option value="{{.}}">{{.}}</option>{{end}}</select></label>
    <label>Reason<input name="reason" maxlength="500" required></label>
    <label>Replacement<input name="replacement" maxlength="500"></label>
    <div class="actions"><button type="submit">Save decision</button><a class="cancel" href="{{.Next}}">Cancel</a></div>
  </form>
</section>
{{end}}
