<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}}</title>
  <link rel="stylesheet" href="/assets/manage-layout.css">
  <style nonce="{{.Navigation.CSPNonce}}">
    :root { color-scheme: light; --bg: #f3f0ea; --panel: #fff; --ink: #1f2428; --muted: #66717a; --accent: #2f6f73; --line: #d9e0e2; --danger: #9a4038; }
    {{template "manage-navigation-styles" .Navigation}}
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--ink); }
    h1 { margin: 0 0 8px; font-size: 32px; }
    .subtitle { margin: 0 0 20px; color: var(--muted); line-height: 1.5; }
    .panel { padding: 22px; border: 1px solid #d6a09b; border-radius: 8px; background: var(--panel); box-shadow: 0 10px 30px rgba(31, 36, 40, 0.05); }
    .resource { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 8px 18px; margin: 0 0 20px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
    .resource dt { color: var(--muted); font-weight: 700; }
    .resource dd { min-width: 0; margin: 0; overflow-wrap: anywhere; }
    .badge { display: inline-flex; align-items: center; min-height: 24px; margin-right: 6px; padding: 2px 8px; border: 1px solid #d6a09b; border-radius: 999px; background: #fff4f2; color: var(--danger); font-size: 12px; font-weight: 700; }
    form { display: grid; gap: 16px; width: 100%; }
    label { color: var(--muted); font-size: 13px; font-weight: 700; }
    input { width: 100%; margin-top: 6px; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--ink); font: inherit; }
    input { height: 42px; padding: 0 11px; }
    input:focus { border-color: #b56760; outline: 3px solid #f2d7d4; }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .danger-button, .cancel { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 16px; border-radius: 6px; font: inherit; font-weight: 800; text-decoration: none; }
    .danger-button { border: 1px solid var(--danger); background: var(--danger); color: #fff; cursor: pointer; }
    .danger-button:hover, .danger-button:focus-visible { background: #7f312b; outline: none; }
    .cancel { border: 1px solid var(--line); background: #fff; color: var(--accent); }
    .cancel:hover, .cancel:focus-visible { border-color: var(--accent); outline: none; }
    .notice { margin-bottom: 16px; padding: 11px 13px; border-radius: 6px; background: #f9eceb; color: var(--danger); }
    @media (max-width: 640px) { main { padding: 24px 14px 40px; } .panel { padding: 16px; } .resource { grid-template-columns: 1fr; gap: 3px; } }
  </style>
</head>
<body>
  <main>
    {{template "manage-navigation" .Navigation}}
    <header>
      <h1>{{.Title}}</h1>
      <p class="subtitle">This permanently removes the selected {{.ResourceKind}}. Supply an operational reason and type the exact resource identity to continue.</p>
    </header>
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}
    <section class="panel">
      <dl class="resource">
        <dt>Resource</dt><dd><code>{{.Resource}}</code></dd>
        {{if .Latest}}<dt>Latest release</dt><dd>{{.Latest}}</dd>{{end}}
        {{if or .IsLatest .Active}}<dt>Protection</dt><dd>{{if .IsLatest}}<span class="badge">latest</span>{{end}}{{if .Active}}<span class="badge">in use</span>{{end}}</dd>{{end}}
      </dl>
      <form method="post" action="{{.Action}}">
        {{csrfInput .CSRFToken}}
        <input type="hidden" name="force" value="true">
        <input type="hidden" name="next" value="{{.Next}}">
        <input type="hidden" name="error_next" value="{{.ErrorNext}}">
        <label>Reason<input name="reason" maxlength="500" required></label>
        <label>Type <code>{{.Resource}}</code> to confirm<input name="confirmation" autocomplete="off" required></label>
        <div class="actions"><button class="danger-button" type="submit">{{.Title}}</button><a class="cancel" href="{{.Next}}">Cancel</a></div>
      </form>
    </section>
  </main>
</body>
</html>
