{{define "list-filter"}}
      <form id="{{.ID}}" class="list-filter" method="get" action="{{.Action}}" data-async-filter="{{.Target}}">
        {{range .Params}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}
        <label class="visually-hidden" for="{{.InputID}}">{{.Label}}</label>
        <input id="{{.InputID}}" name="{{.Name}}" type="search" placeholder="{{.Placeholder}}" value="{{.Value}}" autocomplete="off">
        {{if .ClearURL}}<a class="list-filter-clear" href="{{.ClearURL}}" aria-label="Clear filter">&times;</a>{{end}}
      </form>
{{end}}
