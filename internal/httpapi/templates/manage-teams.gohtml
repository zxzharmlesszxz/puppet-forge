<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Teams</title>
  <style nonce="{{.Navigation.CSPNonce}}">
    :root {
      color-scheme: light;
      --bg: #f3f0ea;
      --panel: #ffffff;
      --ink: #1f2428;
      --muted: #66717a;
      --accent: #2f6f73;
      --line: #d9e0e2;
      --danger: #a33a32;
      --ok: #2e7146;
    }
    {{template "manage-navigation-styles" .Navigation}}
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--ink);
    }
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 32px 20px 56px;
    }
    header {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      margin-bottom: 20px;
    }
    h1 { margin: 0; font-size: 32px; }
    .subtitle { margin-top: 8px; color: var(--muted); }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
    }
    .team-row {
      display: grid;
      grid-template-columns: minmax(160px, 1.1fr) minmax(220px, 1.5fr) repeat(3, minmax(90px, .55fr));
      gap: 16px;
      align-items: center;
      min-height: 82px;
      padding: 16px 20px;
      color: inherit;
      text-decoration: none;
      border-bottom: 1px solid var(--line);
      transition: background-color .15s ease, box-shadow .15s ease;
    }
    .team-row:last-child { border-bottom: 0; }
    .team-row:hover, .team-row:focus-visible {
      background: #eef6f5;
      box-shadow: inset 4px 0 0 var(--accent);
      outline: none;
    }
    .team-name { font-size: 18px; font-weight: 750; }
    .spaces {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      min-height: 26px;
      padding: 3px 8px;
      border: 1px solid #cbd8d9;
      border-radius: 999px;
      background: #f7fbfb;
      color: #355f62;
      font-size: 12px;
      font-weight: 700;
    }
    .metric { min-width: 0; }
    .metric strong { display: block; font-size: 18px; }
    .metric span { display: block; margin-top: 3px; color: var(--muted); font-size: 12px; }
    .notice {
      margin-bottom: 16px;
      padding: 11px 13px;
      border-radius: 6px;
      background: #eef5ef;
      color: var(--ok);
    }
    .notice.error { background: #f9eceb; color: var(--danger); }
    .empty { padding: 28px 20px; color: var(--muted); }
    @media (max-width: 820px) {
      .team-row { grid-template-columns: 1fr 1fr; }
      .team-row .team-name, .team-row .spaces { grid-column: 1 / -1; }
    }
    @media (max-width: 640px) {
      header { display: block; }
      .team-row { grid-template-columns: 1fr; }
      .team-row .team-name, .team-row .spaces { grid-column: auto; }
    }
  </style>
</head>
<body>
  <main>
    {{template "manage-navigation" .Navigation}}
    <header>
      <div>
        <h1>Teams</h1>
        <div class="subtitle">Access, publishing spaces, and owned modules.</div>
      </div>
    </header>

    {{if .Message}}<div class="notice" role="status">{{.Message}}</div>{{end}}
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}

    <section class="panel" id="teams-list" data-async-list aria-label="Manageable teams">
      <form class="list-filter" method="get" data-async-filter="teams-list">
        <label class="visually-hidden" for="teams-query">Filter teams</label>
        <input id="teams-query" name="q" type="search" placeholder="Filter by team or publish space" value="{{.Query}}" autocomplete="off">
        {{if .Query}}<a class="list-filter-clear" href="{{.ClearURL}}" aria-label="Clear team filter">&times;</a>{{end}}
      </form>
      {{if .Teams}}
      {{range .Teams}}
      <a class="team-row" href="/manage/teams/{{.Team}}/access">
        <span class="team-name">{{.Team}}</span>
        <span class="spaces">{{range .Spaces}}<span class="badge">{{.}}</span>{{end}}</span>
        <span class="metric"><strong>{{.ModuleCount}}</strong><span>modules</span></span>
        <span class="metric"><strong>{{.PublishTokens}} / {{.ReadTokens}}</strong><span>publish / read tokens</span></span>
        <span class="metric"><strong>{{.PublishGroups}} / {{.TeamAdminUsers}} / {{.TeamAdminGroups}}</strong><span>publish groups / admin users / admin groups</span></span>
      </a>
      {{end}}
      {{else}}
      <div class="empty">{{if .Query}}No teams match this filter.{{else}}No manageable teams.{{end}}</div>
      {{end}}
      {{if .Pagination.Total}}<nav class="list-pagination" aria-label="Team pages">
        <span>{{.Pagination.Total}} teams &middot; page {{.Pagination.Page}} of {{.Pagination.TotalPages}}</span>
        {{template "page-size-control" .Pagination}}
        <span class="list-pagination-links">
          {{if .Pagination.HasPrev}}<a href="{{.Pagination.PrevURL}}">Previous</a>{{else}}<span class="list-pagination-disabled">Previous</span>{{end}}
          {{if .Pagination.HasNext}}<a href="{{.Pagination.NextURL}}">Next</a>{{else}}<span class="list-pagination-disabled">Next</span>{{end}}
        </span>
      </nav>{{end}}
    </section>
  </main>
</body>
</html>
