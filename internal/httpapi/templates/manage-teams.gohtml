{{template "layout" .}}

{{define "page-title"}}Teams{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/manage-teams.css">{{end}}

{{define "page-subtitle"}}<div class="subtitle">Access, publishing spaces, and owned modules.</div>{{end}}

{{define "page-content"}}
{{template "page-header" .}}

{{template "notices" (notices .Message .Error)}}

<section class="panel list-panel" id="teams-list" data-async-list aria-label="Manageable teams">
  {{template "list-filter" .Filter}}
  {{if .Teams}}
  {{range .Teams}}
  <a class="team-row" href="/manage/teams/{{.Team}}/access">
    <span class="team-name">{{.Team}}</span>
    <span class="spaces">{{range .Spaces}}<span class="badge">{{.}}</span>{{end}}</span>
    <span class="metric"><strong>{{.ModuleCount}}</strong><span>modules</span></span>
    <span class="metric"><strong>{{.PublishTokens}} / {{.ReadTokens}}</strong><span>publish / read tokens</span></span>
    <span class="metric"><strong>{{.PublishGroups}} / {{.TeamAdminUsers}} / {{.TeamAdminGroups}}</strong><span>publish groups / admin users / admin groups</span></span>
  </a>
  {{end}}
  {{else}}
  <div class="empty">{{if .Query}}No teams match this filter.{{else}}No manageable teams.{{end}}</div>
  {{end}}
  {{template "pagination" (paginationView .Pagination "teams" "list-pagination" "Team pages")}}
</section>
{{end}}
