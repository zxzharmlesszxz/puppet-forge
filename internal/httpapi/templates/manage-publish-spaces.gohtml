<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Publish spaces</title>
  <style nonce="{{.Navigation.CSPNonce}}">
    :root {
      color-scheme: light;
      --bg: #f3f0ea;
      --panel: #ffffff;
      --ink: #1f2428;
      --muted: #66717a;
      --accent: #2f6f73;
      --line: #d9e0e2;
      --danger: #a33a32;
      --ok: #2e7146;
    }
    {{template "manage-navigation-styles" .Navigation}}
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--ink); }
    main { max-width: 1080px; margin: 0 auto; padding: 32px 20px 56px; }
    header { margin-bottom: 20px; }
    h1 { margin: 0; font-size: 32px; }
    .subtitle { margin-top: 8px; color: var(--muted); }
    .panel { margin-bottom: 18px; overflow: hidden; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
    .assignment-form { display: grid; grid-template-columns: minmax(180px, 1fr) minmax(220px, 1.5fr) auto; gap: 12px; align-items: end; padding: 20px; }
    label { display: block; margin-bottom: 6px; color: var(--muted); font-size: 13px; font-weight: 700; }
    input, select { width: 100%; height: 42px; padding: 0 11px; border: 1px solid var(--line); border-radius: 6px; background: #fff; color: var(--ink); font: inherit; }
    input:focus, select:focus { border-color: #81aeb0; outline: 3px solid #dceced; }
    button { min-height: 42px; padding: 0 16px; border: 1px solid var(--accent); border-radius: 6px; background: var(--accent); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
    .remove-button { min-height: 32px; padding: 0 10px; border-color: #d6a09b; background: #fff; color: var(--danger); font-size: 12px; }
    .remove-button:hover, .remove-button:focus-visible { border-color: var(--danger); background: #f9eceb; outline: none; }
    .notice { margin-bottom: 16px; padding: 11px 13px; border-radius: 6px; background: #eef5ef; color: var(--ok); }
    .notice.error { background: #f9eceb; color: var(--danger); }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; }
    th, td { padding: 13px 20px; }
    th { color: var(--muted); font-size: 12px; text-transform: uppercase; }
    tbody tr { border-top: 1px solid var(--line); }
    tbody tr[data-href] { cursor: pointer; transition: background-color 140ms ease, box-shadow 140ms ease; }
    tbody tr[data-href]:hover, tbody tr[data-href]:focus-visible { background: #edf6f5; box-shadow: inset 4px 0 var(--accent); outline: none; }
    a { color: var(--accent); text-decoration: none; font-weight: 700; }
    .badge { display: inline-flex; align-items: center; min-height: 26px; padding: 3px 8px; border: 1px solid #cbd8d9; border-radius: 999px; background: #f7fbfb; color: #355f62; font-size: 12px; font-weight: 700; }
    .badge.primary { border-color: #87b79a; background: #eef7f1; color: #2e7146; }
    .badge.upstream { border-color: #9eb3c5; background: #f0f5f8; color: #36566f; }
    .badge.read-only { border-color: #aab4bd; background: #f3f5f6; color: #4d5b66; }
    .count-link { white-space: nowrap; }
    .muted { color: var(--muted); }
    .empty { padding: 28px 20px; color: var(--muted); text-align: center; }
    td form { margin: 0; }
    @media (max-width: 700px) {
      .assignment-form { grid-template-columns: 1fr; }
      .assignment-form button { width: 100%; }
    }
  </style>
</head>
<body>
  <main>
    {{template "manage-navigation" .Navigation}}
    <header>
      <h1>Publish spaces</h1>
      <div class="subtitle">Assign additional publishing namespaces to teams and inspect read-only namespaces synchronized from the official Forge.</div>
    </header>

    {{if .Message}}<div class="notice" role="status">{{.Message}}</div>{{end}}
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}

    <section class="panel" aria-label="Assign publish space">
      {{if .Teams}}<form class="assignment-form" method="post" action="/manage/admin/spaces">
        {{csrfInput .CSRFToken}}
        <input type="hidden" name="action" value="assign">
        <div><label for="publish-space-team">Team</label><select id="publish-space-team" name="team" required>{{range .Teams}}<option value="{{.}}">{{.}}</option>{{end}}</select></div>
        <div><label for="publish-space-name">Extra publish space</label><input id="publish-space-name" name="space" placeholder="shared-modules" pattern="[a-z0-9][a-z0-9_-]*" maxlength="128" required></div>
        <button type="submit">Assign space</button>
      </form>{{else}}<div class="empty">Create a team before assigning extra publish spaces.</div>{{end}}
    </section>

    <section class="panel" id="publish-space-list" data-async-list aria-label="Publish space assignments">
      {{template "list-filter" .Filter}}
      {{if .Assignments}}<div class="table-wrap"><table>
        <thead><tr><th scope="col">Team</th><th scope="col">Publish space</th><th scope="col">Type</th><th scope="col">Modules</th><th scope="col">Action</th></tr></thead>
        <tbody>{{range .Assignments}}<tr data-href="{{.ModulesURL}}" tabindex="0" role="link" aria-label="View modules in {{.Space}} publish space">
          <td>{{if .Upstream}}<span class="muted">Official Forge</span>{{else}}<a href="{{.TeamURL}}">{{.Team}}</a>{{end}}</td>
          <td>{{.Space}}</td>
          <td><span class="badge{{if .Upstream}} upstream{{else if .Primary}} primary{{end}}">{{if .Upstream}}Upstream{{else if .Primary}}Primary{{else}}Extra{{end}}</span></td>
          <td><a class="count-link" href="{{.ModulesURL}}">{{.ModuleCount}} module{{if ne .ModuleCount 1}}s{{end}}</a></td>
          <td>{{if .Upstream}}<span class="badge read-only">Read only</span>{{else if .Primary}}<span class="badge primary">Automatic</span>{{else}}<form method="post" action="/manage/admin/spaces">{{csrfInput $.CSRFToken}}<input type="hidden" name="action" value="unassign"><input type="hidden" name="team" value="{{.Team}}"><input type="hidden" name="space" value="{{.Space}}"><button class="remove-button" type="submit">Unassign</button></form>{{end}}</td>
        </tr>{{end}}</tbody>
      </table></div>{{else}}<div class="empty">{{if .Query}}No publish spaces match this filter.{{else}}No publish spaces configured.{{end}}</div>{{end}}
      {{if .Pagination.Total}}<nav class="list-pagination" aria-label="Publish space pages">
        <span>{{.Pagination.Total}} spaces &middot; page {{.Pagination.Page}} of {{.Pagination.TotalPages}}</span>
        {{template "page-size-control" .Pagination}}
        <span class="list-pagination-links">
          {{if .Pagination.HasPrev}}<a href="{{.Pagination.PrevURL}}">Previous</a>{{else}}<span class="list-pagination-disabled">Previous</span>{{end}}
          {{if .Pagination.HasNext}}<a href="{{.Pagination.NextURL}}">Next</a>{{else}}<span class="list-pagination-disabled">Next</span>{{end}}
        </span>
      </nav>{{end}}
    </section>
  </main>
  <script nonce="{{.Navigation.CSPNonce}}">
    (() => {
      const openRow = (row) => {
        if (row?.dataset.href) window.location.assign(row.dataset.href);
      };
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Element) || event.target.closest("a, button, input, select, textarea, form")) return;
        openRow(event.target.closest("#publish-space-list tr[data-href]"));
      });
      document.addEventListener("keydown", (event) => {
        const row = event.target;
        if (!(row instanceof HTMLTableRowElement) || !row.matches("#publish-space-list tr[data-href]") || (event.key !== "Enter" && event.key !== " ")) return;
        event.preventDefault();
        openRow(row);
      });
    })();
  </script>
</body>
</html>
