{{template "layout" .}}

{{define "page-title"}}Publish spaces{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/manage-publish-spaces.css">{{end}}

{{define "page-subtitle"}}<div class="subtitle">Team namespaces and read-only namespaces synchronized from the official Forge.</div>{{end}}

{{define "page-content"}}
{{template "page-header" .}}

{{template "notices" (notices .Message .Error)}}

<section class="panel list-panel" id="publish-space-list" data-async-list aria-label="Publish space assignments">
  {{template "list-filter" .Filter}}
  {{if .Assignments}}<div class="table-wrap"><table>
    <thead><tr><th scope="col">Team</th><th scope="col">Publish space</th><th scope="col">Type</th><th scope="col">Modules</th><th scope="col">Action</th></tr></thead>
    <tbody>{{range .Assignments}}<tr data-href="{{.ModulesURL}}" tabindex="0" role="link" aria-label="View modules in {{.Space}} publish space">
      <td>{{if .Upstream}}<span class="muted">Official Forge</span>{{else}}<a href="{{.TeamURL}}">{{.Team}}</a>{{end}}</td>
      <td>{{.Space}}</td>
      <td><span class="badge{{if .Upstream}} upstream{{else if .Primary}} primary{{end}}">{{if .Upstream}}Upstream{{else if .Primary}}Primary{{else}}Extra{{end}}</span></td>
      <td><a class="count-link" href="{{.ModulesURL}}">{{.ModuleCount}} module{{if ne .ModuleCount 1}}s{{end}}</a></td>
      <td>{{if .Upstream}}<span class="badge read-only">Read only</span>{{else}}<span class="badge primary">Automatic</span>{{end}}</td>
    </tr>{{end}}</tbody>
  </table></div>{{else}}<div class="empty">{{if .Query}}No publish spaces match this filter.{{else}}No publish spaces configured.{{end}}</div>{{end}}
  {{template "pagination" (paginationView .Pagination "spaces" "list-pagination" "Publish space pages")}}
</section>
{{end}}

{{define "page-scripts"}}
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/manage-publish-spaces.js" defer></script>
{{end}}
