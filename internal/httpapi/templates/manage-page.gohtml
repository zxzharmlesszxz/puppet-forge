<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Manage Modules</title>
  <style nonce="{{.Navigation.CSPNonce}}">
    :root {
      color-scheme: light;
      --bg: #f3f0ea;
      --panel: #ffffff;
      --ink: #1f2428;
      --muted: #66717a;
      --accent: #2f6f73;
      --line: #d9e0e2;
      --danger: #a33a32;
      --ok: #2e7146;
    }
    {{template "manage-navigation-styles" .Navigation}}
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: var(--bg);
      color: var(--ink);
    }
    main {
      max-width: 1080px;
      margin: 0 auto;
      padding: 32px 20px 56px;
    }
    header {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      margin-bottom: 20px;
    }
    h1 {
      margin: 0;
      font-size: 32px;
      line-height: 1.15;
    }
    h2 {
      margin: 0 0 16px;
      font-size: 20px;
    }
    .meta {
      margin-top: 8px;
      color: var(--muted);
      font-size: 14px;
    }
    .muted { color: var(--muted); }
    a, .link-button {
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
    }
    .link-button {
      border: 0;
      background: transparent;
      padding: 0;
      cursor: pointer;
      font: inherit;
    }
    .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 22px;
      margin-top: 18px;
      box-shadow: 0 10px 30px rgba(31, 36, 40, 0.05);
    }
    .notice {
      padding: 12px 14px;
      border-radius: 6px;
      margin-bottom: 16px;
      font-size: 14px;
    }
    .notice.ok {
      color: var(--ok);
      background: rgba(46, 113, 70, 0.1);
    }
    .notice.error {
      color: var(--danger);
      background: rgba(163, 58, 50, 0.1);
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    .field-full {
      grid-column: 1 / -1;
    }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    label {
      display: block;
      margin-bottom: 7px;
      color: var(--muted);
      font-size: 13px;
      font-weight: 700;
    }
    .section-lead {
      margin: -6px 0 18px;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
    }
    .label-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      margin-bottom: 7px;
    }
    .label-row label {
      margin-bottom: 0;
    }
    .field-pill {
      flex: 0 0 auto;
      border-radius: 999px;
      padding: 2px 8px;
      background: rgba(47, 111, 115, 0.09);
      color: var(--accent);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }
    .field-pill.optional {
      background: rgba(102, 113, 122, 0.1);
      color: var(--muted);
    }
    .field-hint {
      margin: 6px 0 0;
      color: var(--muted);
      font-size: 12px;
      line-height: 1.35;
    }
    .panel-disclosure > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      cursor: pointer;
      list-style: none;
    }
    .panel-disclosure > summary::-webkit-details-marker { display: none; }
    .panel-disclosure > summary::after {
      content: "+";
      color: var(--accent);
      font-size: 24px;
      line-height: 1;
    }
    .panel-disclosure[open] > summary::after { content: "−"; }
    .panel-disclosure > summary h2 { margin: 0; }
    .panel-disclosure-content {
      padding-top: 18px;
    }
    input, select, textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 10px 12px;
      font: inherit;
      background: white;
    }
    .replace-option {
      display: flex;
      grid-column: 1 / -1;
      align-items: flex-start;
      gap: 10px;
      margin: 0;
      padding: 12px;
      border: 1px solid #e1c27a;
      border-radius: 6px;
      background: #fff8e5;
      color: var(--ink);
      cursor: pointer;
    }
    .replace-option input { width: 18px; height: 18px; margin: 1px 0 0; padding: 0; flex: 0 0 auto; }
    .replace-option span { display: block; }
    .replace-option small { display: block; margin-top: 3px; color: var(--muted); font-weight: 400; line-height: 1.35; }
    textarea {
      min-height: 72px;
      resize: vertical;
    }
    .primary {
      height: 42px;
      margin-top: 16px;
      padding: 0 18px;
      border: 0;
      border-radius: 6px;
      background: var(--accent);
      color: white;
      font-weight: 700;
      cursor: pointer;
    }
    .release-version {
      display: inline-flex;
      gap: 7px;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 5px 8px;
      white-space: nowrap;
      transition: background 0.15s, border-color 0.15s, box-shadow 0.15s;
    }
    .release-version:hover,
    .release-version:focus-within {
      background: rgba(47, 111, 115, 0.055);
      border-color: rgba(47, 111, 115, 0.28);
      box-shadow: 0 4px 12px rgba(31, 36, 40, 0.06);
    }
    .release-version.is-latest {
      border-color: #2f6f95;
      background: #e6f3f9;
      color: #153f58;
    }
    .release-version.is-latest:hover,
    .release-version.is-latest:focus-within {
      background: #d9edf7;
      border-color: #2f6f95;
    }
    .release-version.is-active {
      border-color: #6f5aa8;
      background: #eeeafd;
      color: #3d2d75;
    }
    .release-version.is-active:hover,
    .release-version.is-active:focus-within {
      background: #e4defa;
      border-color: #6f5aa8;
    }
    .release-version:has(.release-danger-button:hover),
    .release-version:has(.release-danger-button:focus-visible) {
      background: rgba(163, 58, 50, 0.075);
      border-color: var(--danger);
      box-shadow: 0 5px 16px rgba(163, 58, 50, 0.2);
    }
    .usage-badge {
      color: currentColor;
      font-size: 12px;
      opacity: 0.72;
    }
    .badge {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 20px;
      background: rgba(47, 111, 115, 0.1);
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
    }
    .danger-button,
    .release-danger-button {
      border: 1px solid rgba(163, 58, 50, 0.45);
      border-radius: 6px;
      background: rgba(163, 58, 50, 0.06);
      color: var(--danger);
      font: inherit;
      font-weight: 800;
      cursor: pointer;
    }
    .danger-button {
      min-height: 32px;
      padding: 0 12px;
      font-size: 13px;
    }
    .release-danger-button {
      min-height: 24px;
      padding: 0 8px;
      font-size: 12px;
    }
    .danger-button:hover,
    .danger-button:focus-visible,
    .release-danger-button:hover,
    .release-danger-button:focus-visible {
      background: var(--danger);
      border-color: var(--danger);
      color: white;
      outline: none;
    }
    .danger {
      color: var(--danger);
    }
    .empty {
      color: var(--muted);
      padding: 16px 0 0;
    }
    .pagination {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 13px;
    }
    .pagination-links {
      display: flex;
      gap: 12px;
    }
    .pagination-disabled {
      color: #a2aaaf;
      font-weight: 700;
    }
    @media (max-width: 720px) {
      header {
        display: block;
      }
      .grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>
  <main>
    {{template "manage-navigation" .Navigation}}
    <header>
      <div>
        <h1>Manage Modules</h1>
        <div class="meta">{{if .Principal.CanAdmin}}Global administrator{{if .Teams}} · {{if eq (len .Teams) 1}}Team:{{else}}Teams:{{end}} {{range $i, $team := .Teams}}{{if $i}}, {{end}}{{$team}}{{end}}{{end}}{{else}}{{if eq (len .Teams) 1}}Team:{{else}}Teams:{{end}} {{range $i, $team := .Teams}}{{if $i}}, {{end}}{{$team}}{{end}}{{end}}{{if .Owners}} · spaces: {{range $i, $owner := .Owners}}{{if $i}}, {{end}}{{$owner}}{{end}}{{end}}</div>
      </div>
    </header>

    {{if .Message}}<div class="notice ok" role="status">{{.Message}}</div>{{end}}
    {{if .Error}}<div class="notice error" role="alert">{{.Error}}</div>{{end}}

    {{if .Principal.CanPublish}}
    <section class="panel">
      <details class="panel-disclosure" data-section-key="upload-or-update">
        <summary><h2>Upload or Update</h2></summary>
        <div class="panel-disclosure-content">
          <p class="section-lead">Choose an allowed target space and upload a Puppet module archive. Module identity and metadata are read from metadata.json.</p>
          <form method="post" action="/manage/modules" enctype="multipart/form-data" data-async-mutation data-refresh-target="manage-module-list">
            {{csrfInput $.CSRFToken}}
            <div class="grid">
              <div>
                <div class="label-row"><label for="publish-space-select">Space</label><span class="field-pill">Required</span></div>
                <select id="publish-space-select" name="space" required>
                  {{range .Owners}}
                  <option value="{{.}}">{{.}}</option>
                  {{end}}
                </select>
              </div>
              <div>
                <div class="label-row"><label for="module-archive-input">Archive</label><span class="field-pill">Required</span></div>
                <input id="module-archive-input" name="file" type="file" accept=".gz,.tgz,.tar.gz" required>
                <p class="field-hint">Use a Puppet module .tar.gz archive.</p>
              </div>
              {{if or .Principal.CanAdmin .Principal.CanManageTeam}}
              <label class="replace-option">
                <input name="replace" type="checkbox" value="true">
                <span>Replace an existing release with the same version<small>Admin-only correction. Clients that cached the previous checksum may need to retry.</small></span>
              </label>
              {{end}}
            </div>
            <button class="primary" type="submit">Publish</button>
          </form>
        </div>
      </details>
    </section>
    {{end}}

    {{if .Principal.CanAdmin}}
    <section class="panel">
      <details class="panel-disclosure" data-section-key="add-upstream-module">
        <summary><h2>Add Upstream Module</h2></summary>
        <div class="panel-disclosure-content">
          <form method="post" action="/manage/upstream" data-async-mutation data-refresh-target="manage-module-list">
            {{csrfInput $.CSRFToken}}
            <div class="grid">
              <div class="field-full">
                <label for="upstream-input">Module</label>
                <input id="upstream-input" name="module" placeholder="puppetlabs/apache or puppetlabs-apache" required>
              </div>
            </div>
            <button class="primary" type="submit">Add Upstream Module</button>
          </form>
          </div>
      </details>
    </section>
    {{end}}

    <section class="panel" id="manage-module-list" data-async-list>
      <h2>Owned Modules</h2>
      {{template "list-filter" .Filter}}
      {{if .Modules}}
      {{range .Modules}}
      {{template "manage-module-card" .}}
      {{end}}
      {{else}}
      <div class="empty">No modules in this scope.</div>
      {{end}}
      {{if .Pagination.Total}}
      <nav class="pagination" aria-label="Module pages">
        <span>{{.Pagination.Total}} modules · page {{.Pagination.Page}} of {{.Pagination.TotalPages}}</span>
        {{template "page-size-control" .Pagination}}
        <span class="pagination-links">
          {{if .Pagination.HasPrev}}<a href="{{.Pagination.PrevURL}}">Previous</a>{{else}}<span class="pagination-disabled">Previous</span>{{end}}
          {{if .Pagination.HasNext}}<a href="{{.Pagination.NextURL}}">Next</a>{{else}}<span class="pagination-disabled">Next</span>{{end}}
        </span>
      </nav>
      {{end}}
    </section>
  </main>
  <script nonce="{{.Navigation.CSPNonce}}">
    (() => {
      const storageKey = "puppet-forge:manage:open-sections";
      const loadOpenSections = () => {
        try {
          const raw = window.localStorage.getItem(storageKey);
          return raw ? new Set(JSON.parse(raw)) : new Set();
        } catch {
          return new Set();
        }
      };
      const openSections = loadOpenSections();
      const saveOpenSections = () => {
        try {
          window.localStorage.setItem(storageKey, JSON.stringify(Array.from(openSections)));
        } catch (_) {}
      };
      const bindSections = (root) => {
        const sections = [];
        if (root instanceof HTMLDetailsElement && root.dataset.sectionKey) sections.push(root);
        root.querySelectorAll?.("details[data-section-key]").forEach((section) => sections.push(section));
        sections.forEach((section) => {
          if (section.dataset.sectionStateBound) return;
          section.dataset.sectionStateBound = "true";
          if (openSections.has(section.dataset.sectionKey)) section.open = true;
          section.addEventListener("toggle", () => {
            if (section.open) openSections.add(section.dataset.sectionKey);
            else openSections.delete(section.dataset.sectionKey);
            saveOpenSections();
          });
        });
      };
      bindSections(document);
      document.addEventListener("puppet-forge:list-updated", (event) => bindSections(event.target));
      document.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest(".module-actions")) event.stopPropagation();
      });
      document.addEventListener("submit", saveOpenSections);
    })();
  </script>
</body>
</html>
