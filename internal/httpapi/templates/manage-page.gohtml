{{template "layout" .}}

{{define "page-title"}}Manage Modules{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/manage-page.css">{{end}}

{{define "page-subtitle"}}<div class="meta">{{if .Principal.CanAdmin}}Global administrator{{if .Teams}} · {{if eq (len .Teams) 1}}Team:{{else}}Teams:{{end}} {{range $i, $team := .Teams}}{{if $i}}, {{end}}{{$team}}{{end}}{{end}}{{else}}{{if eq (len .Teams) 1}}Team:{{else}}Teams:{{end}} {{range $i, $team := .Teams}}{{if $i}}, {{end}}{{$team}}{{end}}{{end}}{{if .Owners}} · spaces: {{range $i, $owner := .Owners}}{{if $i}}, {{end}}{{$owner}}{{end}}{{end}}</div>{{end}}

{{define "page-section-key"}}puppet-forge:manage:open-sections{{end}}

{{define "page-content"}}
{{template "page-header" .}}

{{template "notices" (notices .Message .Error)}}

{{if .Principal.CanPublish}}
<section class="panel content-panel">
  <details class="panel-disclosure" data-section-key="upload-or-update">
    <summary><h2>Upload or Update</h2></summary>
    <div class="panel-disclosure-content">
      <p class="section-lead">Choose an allowed target space and upload a Puppet module archive. Module identity and metadata are read from metadata.json.</p>
      {{template "publish-form" (publishForm .Owners .CSRFToken "" "manage-module-list" "publish-space-select" "module-archive-input" (or .Principal.CanAdmin .Principal.CanManageTeam))}}
    </div>
  </details>
</section>
{{end}}

{{if .Principal.CanAdmin}}
<section class="panel content-panel">
  <details class="panel-disclosure" data-section-key="add-upstream-module">
    <summary><h2>Add Upstream Module</h2></summary>
    <div class="panel-disclosure-content">
      <form method="post" action="/manage/upstream" data-async-mutation data-refresh-target="manage-module-list">
        {{csrfInput $.CSRFToken}}
        <div class="grid">
          <div class="field-full">
            <label for="upstream-input">Module</label>
            <input id="upstream-input" name="module" placeholder="puppetlabs/apache or puppetlabs-apache" required>
          </div>
        </div>
        <button class="primary" type="submit">Add Upstream Module</button>
      </form>
    </div>
  </details>
</section>
{{end}}

<section class="panel content-panel" id="manage-module-list" data-async-list>
  <h2>Modules</h2>
  {{template "list-filter" .Filter}}
  {{if .Modules}}
  {{range .Modules}}
  {{template "manage-module-card" .}}
  {{end}}
  {{else}}
  <div class="empty">No modules in this scope.</div>
  {{end}}
  {{template "pagination" (paginationView .Pagination "modules" "pagination" "Module pages")}}
</section>
{{end}}
