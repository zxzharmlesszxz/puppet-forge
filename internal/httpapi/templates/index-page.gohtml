{{template "layout" .}}

{{define "page-title"}}Puppet Forge{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/index-page.css">{{end}}

{{define "page-scripts"}}
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/page-size-persistence.js" defer></script>
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/async-lists.js" defer></script>
{{end}}

{{define "page-content"}}
<section class="hero">
  <div class="eyebrow">Local Forge</div>
  <h1>{{if .Owner}}{{.Owner}} Modules{{else}}Published Modules{{end}}</h1>
  <p class="subtitle">{{if .Owner}}Modules published in the {{.Owner}} space.{{else}}Index of all modules currently stored in this service.{{end}} Open any module to view its latest release and extracted README.</p>
</section>
<section class="list" id="module-list" data-async-list>
  {{template "list-filter" .Filter}}
  {{if .Modules}}
    {{range .Modules}}
    <!--suppress HtmlUnknownTarget -->
    <a class="row" href="/modules/{{.Owner}}/{{.Name}}" data-module="{{.Owner}}/{{.Name}}">
      <div class="name">{{.Owner}}/{{.Name}}</div>
      <div class="meta">Latest version: {{if .LatestVersion}}{{.LatestVersion}}{{else}}n/a{{end}}</div>
    </a>
    {{end}}
  {{else}}
  <div class="empty">{{if .Owner}}No modules were found in the {{.Owner}} space.{{else}}No modules have been published yet.{{end}}</div>
  {{end}}
  {{template "pagination" (paginationView .Pagination "modules" "pagination" "Module pages")}}
</section>
{{end}}
