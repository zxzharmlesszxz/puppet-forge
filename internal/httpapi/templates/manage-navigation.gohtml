{{define "manage-navigation-styles"}}
    {{template "list-filter-styles" .}}
    .manage-navigation {
      margin-bottom: 24px;
      border-bottom: 1px solid var(--line);
    }
    .global-navigation,
    .context-navigation,
    .breadcrumbs {
      display: flex;
      align-items: center;
      min-width: 0;
    }
    .global-navigation {
      min-height: 52px;
      gap: 6px;
    }
    .global-navigation a,
    .context-navigation a,
    .global-navigation .link-button {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      padding: 0 11px;
      border-radius: 6px;
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
      white-space: nowrap;
    }
    .global-navigation a:hover,
    .global-navigation a:focus-visible,
    .context-navigation a:hover,
    .context-navigation a:focus-visible,
    .global-navigation .link-button:hover,
    .global-navigation .link-button:focus-visible {
      background: rgba(47, 111, 115, 0.09);
      outline: none;
    }
    .global-navigation a[aria-current="page"],
    .context-navigation a[aria-current="page"] {
      background: var(--accent);
      color: #fff;
    }
    .global-navigation .public-link {
      margin-right: auto;
      padding-left: 0;
      font-weight: 800;
    }
    .global-navigation form { margin: 0; }
    .administration-menu {
      position: relative;
      flex: 0 0 auto;
    }
    .administration-menu summary {
      display: inline-flex;
      align-items: center;
      min-height: 36px;
      padding: 0 11px;
      border-radius: 6px;
      color: var(--accent);
      font-weight: 700;
      white-space: nowrap;
      cursor: pointer;
      list-style: none;
    }
    .administration-menu summary::-webkit-details-marker { display: none; }
    .administration-menu summary::after {
      content: "";
      width: 7px;
      height: 7px;
      margin: -4px 0 0 9px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(45deg);
    }
    .administration-menu summary:hover,
    .administration-menu summary:focus-visible {
      background: rgba(47, 111, 115, 0.09);
      outline: none;
    }
    .administration-menu.active summary {
      background: var(--accent);
      color: #fff;
    }
    .administration-dropdown {
      position: absolute;
      z-index: 20;
      top: calc(100% + 4px);
      right: 0;
      display: none;
      min-width: 190px;
      padding: 6px;
      border: 1px solid var(--line);
      border-radius: 7px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(31, 36, 40, 0.16);
    }
    .administration-menu[open] .administration-dropdown { display: block; }
    .administration-dropdown a {
      display: flex;
      width: 100%;
      min-height: 38px;
      padding: 0 10px;
    }
    @media (hover: hover) and (pointer: fine) {
      .administration-menu:hover .administration-dropdown { display: block; }
    }
    .global-navigation .link-button {
      min-height: 36px;
      margin: 0;
      border: 0;
      background: transparent;
      font: inherit;
      cursor: pointer;
    }
    .breadcrumbs {
      min-height: 34px;
      gap: 8px;
      overflow-x: auto;
      color: var(--muted);
      font-size: 13px;
      scrollbar-width: thin;
    }
    .breadcrumbs span {
      display: inline-flex;
      align-items: center;
      white-space: nowrap;
    }
    .breadcrumbs span + span::before {
      content: "/";
      margin-right: 8px;
      color: #9aa3a8;
    }
    .breadcrumbs a {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 0 7px;
      border-radius: 5px;
      color: var(--muted);
      text-decoration: none;
    }
    .breadcrumbs a:hover,
    .breadcrumbs a:focus-visible {
      background: rgba(47, 111, 115, 0.11);
      color: var(--accent);
      outline: none;
    }
    .breadcrumbs [aria-current="page"] { color: var(--ink); font-weight: 700; }
    .context-navigation {
      min-height: 46px;
      justify-content: space-between;
      gap: 16px;
      overflow-x: auto;
      border-top: 1px solid rgba(217, 224, 226, 0.7);
      scrollbar-width: thin;
    }
    .context-navigation a { font-size: 14px; }
    .team-navigation {
      display: inline-flex;
      align-items: center;
      flex: 0 0 auto;
      gap: 4px;
    }
    .notice {
      position: relative;
      padding-right: 46px !important;
      transition: opacity 180ms ease, transform 180ms ease, margin 180ms ease, padding 180ms ease, max-height 180ms ease;
    }
    .notice.is-dismissing {
      max-height: 0;
      margin-top: 0;
      margin-bottom: 0;
      padding-top: 0;
      padding-bottom: 0;
      overflow: hidden;
      opacity: 0;
      transform: translateY(-6px);
    }
    .notice-dismiss {
      position: absolute;
      top: 50%;
      right: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      min-height: 30px;
      margin: 0;
      padding: 0;
      transform: translateY(-50%);
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: currentColor;
      font: inherit;
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      opacity: 0.72;
    }
    .notice-dismiss:hover,
    .notice-dismiss:focus-visible {
      background: rgba(31, 36, 40, 0.08);
      outline: none;
      opacity: 1;
    }
    .list-pagination {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 14px 20px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 13px;
    }
    .list-pagination-links,
    .pagination-links { display: flex; gap: 8px; }
    .list-pagination-links a,
    .pagination-links a,
    .list-pagination-disabled,
    .pagination-disabled {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 0 10px;
      border: 1px solid var(--line);
      border-radius: 5px;
      color: var(--accent);
      text-decoration: none;
      font-weight: 700;
      transition: border-color .15s ease, background-color .15s ease, box-shadow .15s ease;
    }
    .list-pagination-links a:hover,
    .list-pagination-links a:focus-visible,
    .pagination-links a:hover,
    .pagination-links a:focus-visible {
      border-color: #81aeb0;
      background: #eef6f5;
      box-shadow: 0 0 0 3px #dceced;
      outline: 0;
    }
    .list-pagination-disabled,
    .pagination-disabled { opacity: .5; }
    .page-size-control {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      margin: 0;
      color: var(--muted);
      font-size: 13px;
      white-space: nowrap;
    }
    .page-size-control label { margin: 0; color: inherit; font: inherit; }
    .page-size-control select {
      width: auto;
      min-width: 68px;
      height: 32px;
      padding: 0 24px 0 8px;
      border: 1px solid var(--line);
      border-radius: 5px;
      background-color: #fff;
      color: var(--ink);
      font: inherit;
      cursor: pointer;
    }
    .module-details {
      margin-top: 14px;
      padding: 6px 10px 10px;
      border: 1px solid transparent;
      border-radius: 8px;
      transition: background-color .15s ease, border-color .15s ease, box-shadow .15s ease;
    }
    .module-details:hover,
    .module-details:focus-within {
      border-color: rgba(47, 111, 115, 0.18);
      background: rgba(47, 111, 115, 0.045);
      box-shadow: 0 6px 18px rgba(31, 36, 40, 0.04);
    }
    .module-details:has(.danger-button:hover),
    .module-details:has(.danger-button:focus-visible) {
      border-color: var(--danger);
      background: rgba(163, 58, 50, 0.055);
      box-shadow: 0 8px 22px rgba(163, 58, 50, 0.18);
    }
    .module-details > summary.catalog-item {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
      padding: 6px 0;
      cursor: pointer;
      list-style: none;
    }
    .module-details > summary.catalog-item::before {
      content: "▶";
      color: var(--muted);
      font-size: 12px;
      transition: transform .15s ease;
    }
    .module-details[open] > summary.catalog-item::before { content: "▼"; }
    .module-details > summary.catalog-item::-webkit-details-marker { display: none; }
    .module-details .item-title {
      min-width: 0;
      overflow-wrap: anywhere;
      font-size: 18px;
      font-weight: 700;
    }
    .module-details .item-subtitle {
      color: var(--muted);
      font-size: 14px;
    }
    .module-details .module-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-left: auto;
    }
    .module-details > .release-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .notice { transition: none; }
    }
    @media (max-width: 720px) {
      .global-navigation {
        flex-wrap: wrap;
        padding: 8px 0;
      }
      .global-navigation .public-link {
        width: 100%;
        margin-right: 0;
      }
      .context-navigation { align-items: flex-start; }
      .administration-dropdown { right: auto; left: 0; }
    }
{{end}}

{{define "page-size-control"}}
      <form class="page-size-control" method="get" action="{{.SizeAction}}{{if .SizeAnchor}}#{{.SizeAnchor}}{{end}}" data-page-size-key="{{.SizeStorageKey}}" data-page-size-cookie="{{.SizeCookieName}}" data-page-size-param="{{.SizeParam}}" data-page-param="{{.SizePageParam}}" data-rendered-page-size="{{.PageSize}}"{{if .SizeTarget}} data-async-filter="{{.SizeTarget}}"{{end}}>
        {{range .SizeParams}}<input type="hidden" name="{{.Name}}" value="{{.Value}}">{{end}}
        <label>Per page <select name="{{.SizeParam}}" aria-label="Items per page">{{range .SizeOptions}}<option value="{{.Value}}"{{if .Selected}} selected{{end}}>{{.Value}}</option>{{end}}</select></label>
      </form>
{{end}}

{{define "manage-navigation"}}
    <div class="manage-navigation">
      <nav class="global-navigation" aria-label="Global navigation">
        <a class="public-link" href="/">Public modules</a>
        <a href="/manage"{{if .OverviewActive}} aria-current="page"{{end}}>Overview</a>
        <a href="/manage/modules"{{if .ModulesActive}} aria-current="page"{{end}}>Modules</a>
        {{if .CanTeams}}<a href="/manage/teams"{{if .TeamsActive}} aria-current="page"{{end}}>Teams</a>{{end}}
        {{if .CanAdmin}}<details class="administration-menu{{if or .PublishSpacesActive .GlobalAccessActive}} active{{end}}">
          <summary>Administration</summary>
          <span class="administration-dropdown">
            <a href="/manage/admin/spaces"{{if .PublishSpacesActive}} aria-current="page"{{end}}>Publish spaces</a>
            <a href="/manage/admin/access"{{if .GlobalAccessActive}} aria-current="page"{{end}}>Global access</a>
          </span>
        </details>{{end}}
        <form method="post" action="/manage/logout">{{csrfInput .CSRFToken}}<button class="link-button" type="submit">Sign out</button></form>
      </nav>
      {{if .Breadcrumbs}}
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {{range .Breadcrumbs}}{{if .URL}}<span><a href="{{.URL}}">{{.Label}}</a></span>{{else}}<span aria-current="page">{{.Label}}</span>{{end}}{{end}}
      </nav>
      {{end}}
      {{if .TeamsActive}}
      <nav class="context-navigation" aria-label="Management context navigation">
        <span class="team-navigation">
          {{if .TeamPage}}<a href="{{.TeamURL}}/access"{{if .TeamAccessActive}} aria-current="page"{{end}}>Access</a><a href="{{.TeamURL}}/tokens"{{if .TeamTokensActive}} aria-current="page"{{end}}>Tokens</a><a href="{{.TeamURL}}/modules"{{if .TeamModulesActive}} aria-current="page"{{end}}>Modules</a>{{else if .CanAdmin}}<a href="/manage/teams/new"{{if .AddTeamActive}} aria-current="page"{{end}}>Add team</a>{{end}}
        </span>
      </nav>
      {{end}}
    </div>
    <script nonce="{{.CSPNonce}}">
      document.addEventListener("DOMContentLoaded", () => {
        const notices = Array.from(document.querySelectorAll(".notice"));
        if (!notices.length) return;

        const currentURL = new URL(window.location.href);
        currentURL.searchParams.delete("message");
        currentURL.searchParams.delete("error");
        window.history.replaceState(null, "", currentURL.pathname + currentURL.search + currentURL.hash);

        notices.forEach((notice) => {
          const dismissButton = document.createElement("button");
          dismissButton.type = "button";
          dismissButton.className = "notice-dismiss";
          dismissButton.setAttribute("aria-label", "Dismiss notification");
          dismissButton.textContent = "×";
          notice.appendChild(dismissButton);

          let remaining = notice.classList.contains("error") ? 12000 : 6000;
          let startedAt = 0;
          let timer = 0;
          let dismissed = false;

          const pause = () => {
            if (!timer) return;
            window.clearTimeout(timer);
            timer = 0;
            remaining = Math.max(0, remaining - (Date.now() - startedAt));
          };
          const dismiss = () => {
            if (dismissed) return;
            dismissed = true;
            pause();
            notice.classList.add("is-dismissing");
            window.setTimeout(() => notice.remove(), 220);
          };
          const resume = () => {
            if (dismissed || timer || document.hidden || notice.matches(":hover") || notice.contains(document.activeElement)) return;
            if (remaining <= 0) {
              dismiss();
              return;
            }
            startedAt = Date.now();
            timer = window.setTimeout(dismiss, remaining);
          };

          dismissButton.addEventListener("click", dismiss);
          notice.addEventListener("mouseenter", pause);
          notice.addEventListener("mouseleave", resume);
          notice.addEventListener("focusin", pause);
          notice.addEventListener("focusout", () => window.setTimeout(resume));
          document.addEventListener("visibilitychange", () => document.hidden ? pause() : resume());
          resume();
        });
      });
    </script>
    {{template "async-lists" .}}
    {{template "page-size-persistence" .}}
{{end}}
