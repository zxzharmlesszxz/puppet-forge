{{template "layout" .}}

{{define "page-title"}}{{.Module.Owner}}/{{.Module.Name}}{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/module-page.css">{{end}}

{{define "page-content"}}
<section class="hero">
      <div class="meta accent">Module</div>
      <h1>{{.Module.Owner}}/{{.Module.Name}}</h1>
      <div class="meta">{{if .IsUpstream}}Source: official Puppet Forge cache{{else}}Source: local registry{{end}}</div>
      {{if .Release.Description}}<p>{{.Release.Description}}</p>{{end}}
      <nav class="section-links" aria-label="Module sections">
        <a href="#readme">README</a>
        {{if .Release.Version}}<a href="#install">Install</a>{{end}}
      </nav>
    </section>
    <section class="panel" id="readme">
      <h2>README</h2>
      {{if .Release.Readme}}
      <div class="readme">{{.ReadmeHTML}}</div>
      {{else}}
      <div class="empty">README was not found in the published archive.</div>
      {{end}}
    </section>
    {{if .Release.Version}}
    <details class="panel install-panel" id="install">
      <summary>Install</summary>
      <div class="install-grid">
        <div>
          <h3>Direct Tarball Install</h3>
          <p>Download the selected release tarball from this service and install it directly.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">shell</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">curl -L {{.PublicBaseURL}}{{.DownloadPath}} -o {{.ModuleInstallID}}-{{.Release.Version}}.tar.gz
puppet module install ./{{.ModuleInstallID}}-{{.Release.Version}}.tar.gz --ignore-dependencies</code></pre>
          </div>
        </div>
        <div>
          <h3>Use This Forge As Repository</h3>
          <p>Point Puppet to this service as a custom module repository for the selected module version.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">shell</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">puppet module install {{.ModuleInstallID}} --version {{.Release.Version}} \
  --module_repository {{.PublicBaseURL}}</code></pre>
          </div>
        </div>
        <div>
          <h3>Puppetfile With This Forge</h3>
          <p>Configure your Puppetfile to use this service as the Forge source and pin the required module version.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">Puppetfile</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">forge "{{.PublicBaseURL}}"

mod "{{.ModuleInstallID}}", "{{.Release.Version}}"</code></pre>
          </div>
        </div>
        <div>
          <h3>Private Forge Access For r10k</h3>
          <p>If your forge is protected, configure r10k Forge access with a read token and keep the module version pinned in Puppetfile.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">Hiera</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">forge:
  baseurl: '{{.PublicBaseURL}}'
  authorization_token: '{{.ReadTokenHint}}'</code></pre>
          </div>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">Puppetfile</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">forge "{{.PublicBaseURL}}"

mod "{{.ModuleInstallID}}", "{{.Release.Version}}"</code></pre>
          </div>
        </div>
      </div>
    </details>
    {{end}}
{{end}}

{{define "page-scripts"}}
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/clipboard.js" defer></script>
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/module-page.js" defer></script>
{{end}}
