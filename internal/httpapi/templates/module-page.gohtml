<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Module.Owner}}/{{.Module.Name}}</title>
  <style nonce="{{.Navigation.CSPNonce}}">
    :root {
      color-scheme: light;
      --bg: #f6f1e8;
      --panel: #fffaf2;
      --ink: #1d1c19;
      --muted: #6f6a61;
      --accent: #9d3c2a;
      --line: #d8cdbb;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Georgia, "Times New Roman", serif;
      background: radial-gradient(circle at top, #fffaf3 0%, var(--bg) 65%);
      color: var(--ink);
    }
    main {
      max-width: 1152px;
      margin: 0 auto;
      padding: 48px 20px 64px;
    }
    {{template "public-navigation-styles" .Navigation}}
    .hero, .panel {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 18px;
      box-shadow: 0 14px 40px rgba(54, 39, 20, 0.08);
    }
    .hero {
      padding: 28px 30px;
      margin-bottom: 24px;
    }
    h1 {
      margin: 0 0 10px;
      font-size: 42px;
      line-height: 1.1;
    }
    .meta {
      color: var(--muted);
      font-size: 16px;
    }
    .accent {
      color: var(--accent);
      font-weight: 700;
    }
    .section-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 18px;
    }
    .section-links a {
      border: 1px solid var(--line);
      border-radius: 6px;
      padding: 7px 11px;
      color: var(--accent);
      background: rgba(255, 255, 255, 0.5);
      font-family: system-ui, sans-serif;
      font-size: 14px;
      font-weight: 700;
      text-decoration: none;
    }
    .section-links a:hover, .section-links a:focus-visible {
      border-color: var(--accent);
      background: #fff;
      outline: none;
      box-shadow: 0 0 0 3px rgba(157, 60, 42, 0.12);
    }
    .panel {
      padding: 24px 26px;
      min-width: 0;
      scroll-margin-top: 18px;
    }
    .panel + .panel {
      margin-top: 20px;
    }
    h2 {
      margin: 0 0 16px;
      font-size: 24px;
    }
    .readme {
      line-height: 1.7;
      color: #24211b;
    }
    .readme h1, .readme h2, .readme h3 {
      line-height: 1.2;
      margin: 1.2em 0 0.6em;
    }
    .readme p, .readme ul, .readme ol {
      margin: 0 0 1em;
    }
    .readme code {
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 0.95em;
      background: rgba(29, 28, 25, 0.06);
      padding: 0.15em 0.35em;
      border-radius: 6px;
    }
    .readme pre {
      margin: 0;
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 14px;
      line-height: 1.6;
      color: #24211b;
      background: rgba(29, 28, 25, 0.04);
      padding: 14px;
      border-radius: 12px;
      overflow-x: auto;
    }
    .empty {
      color: var(--muted);
      font-style: italic;
    }
    .install-grid {
      display: grid;
      gap: 18px;
      min-width: 0;
    }
    .install-panel {
      padding: 0;
    }
    .install-panel > summary {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      padding: 22px 26px;
      cursor: pointer;
      list-style: none;
      font-size: 24px;
      font-weight: 700;
    }
    .install-panel > summary::-webkit-details-marker {
      display: none;
    }
    .install-panel > summary::after {
      content: "+";
      flex: 0 0 auto;
      color: var(--accent);
      font-family: system-ui, sans-serif;
      font-size: 24px;
      line-height: 1;
    }
    .install-panel[open] > summary::after {
      content: "−";
    }
    .install-panel > summary:hover, .install-panel > summary:focus-visible {
      color: var(--accent);
      outline: none;
    }
    .install-panel > .install-grid {
      padding: 0 26px 24px;
    }
    .install-grid > div {
      min-width: 0;
    }
    .install-grid h3 {
      margin: 0 0 8px;
      font-size: 18px;
    }
    .install-grid p {
      margin: 0 0 10px;
      color: var(--muted);
      line-height: 1.6;
    }
    .code-window {
      max-width: 100%;
      min-width: 0;
      overflow: hidden;
      border: 1px solid #2f3a34;
      border-radius: 8px;
      background: #16211c;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .code-window + .code-window {
      margin-top: 10px;
    }
    .code-titlebar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 38px;
      padding: 8px 10px 8px 14px;
      border-bottom: 1px solid #2f3a34;
      background: #202c26;
    }
    .code-title {
      min-width: 0;
      overflow: hidden;
      color: #d7e5dc;
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 12px;
      font-weight: 700;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .copy-button {
      flex: 0 0 auto;
      min-width: 64px;
      border: 1px solid #52645a;
      border-radius: 6px;
      padding: 5px 9px;
      background: #f8faf7;
      color: #16211c;
      cursor: pointer;
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 12px;
      font-weight: 700;
    }
    .copy-button:hover {
      background: #ffffff;
    }
    .code-window pre {
      margin: 0;
      padding: 14px;
      max-width: 100%;
      overflow-x: auto;
      color: #f0f6ef;
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 13px;
      line-height: 1.6;
      white-space: pre;
    }
    .code-window code {
      font-family: inherit;
      background: transparent;
      padding: 0;
      border-radius: 0;
      color: inherit;
    }
    .readme .code-window {
      margin: 0 0 1em;
    }
  </style>
</head>
<body>
  <main>
    {{template "public-navigation" .Navigation}}
    <section class="hero">
      <div class="meta accent">Module</div>
      <h1>{{.Module.Owner}}/{{.Module.Name}}</h1>
      <div class="meta">{{if .IsUpstream}}Source: official Puppet Forge cache{{else}}Source: local registry{{end}}</div>
      {{if .Release.Description}}<p>{{.Release.Description}}</p>{{end}}
      <nav class="section-links" aria-label="Module sections">
        <a href="#readme">README</a>
        {{if .Release.Version}}<a href="#install">Install</a>{{end}}
      </nav>
    </section>
    <section class="panel" id="readme">
      <h2>README</h2>
      {{if .Release.Readme}}
      <div class="readme">{{.ReadmeHTML}}</div>
      {{else}}
      <div class="empty">README was not found in the published archive.</div>
      {{end}}
    </section>
    {{if .Release.Version}}
    <details class="panel install-panel" id="install">
      <summary>Install</summary>
      <div class="install-grid">
        <div>
          <h3>Direct Tarball Install</h3>
          <p>Download the selected release tarball from this service and install it directly.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">shell</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">curl -L {{.PublicBaseURL}}{{.DownloadPath}} -o {{.ModuleInstallID}}-{{.Release.Version}}.tar.gz
puppet module install ./{{.ModuleInstallID}}-{{.Release.Version}}.tar.gz --ignore-dependencies</code></pre>
          </div>
        </div>
        <div>
          <h3>Use This Forge As Repository</h3>
          <p>Point Puppet to this service as a custom module repository for the selected module version.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">shell</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">puppet module install {{.ModuleInstallID}} --version {{.Release.Version}} \
  --module_repository {{.PublicBaseURL}}</code></pre>
          </div>
        </div>
        <div>
          <h3>Puppetfile With This Forge</h3>
          <p>Configure your Puppetfile to use this service as the Forge source and pin the required module version.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">Puppetfile</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">forge "{{.PublicBaseURL}}"

mod "{{.ModuleInstallID}}", "{{.Release.Version}}"</code></pre>
          </div>
        </div>
        <div>
          <h3>Private Forge Access For r10k</h3>
          <p>If your forge is protected, configure r10k Forge access with a read token and keep the module version pinned in Puppetfile.</p>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">Hiera</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">forge:
  baseurl: '{{.PublicBaseURL}}'
  authorization_token: '{{.ReadTokenHint}}'</code></pre>
          </div>
          <div class="code-window">
            <div class="code-titlebar">
              <span class="code-title">Puppetfile</span>
              <button class="copy-button" type="button">Copy</button>
            </div>
            <pre><code class="language-code">forge "{{.PublicBaseURL}}"

mod "{{.ModuleInstallID}}", "{{.Release.Version}}"</code></pre>
          </div>
        </div>
      </div>
    </details>
    {{end}}
  </main>
  <script nonce="{{.Navigation.CSPNonce}}">
    {{template "clipboard-script" .}}
    /** @type {(text: string) => Promise<boolean>} */
    const copyText = window['copyTextToClipboard'];
    const versionSelect = /** @type {HTMLSelectElement|null} */ (document.getElementById('version-select'));
    if (versionSelect) {
      versionSelect.addEventListener('change', () => {
        const url = new URL(window.location.href);
        url.searchParams.set('version', versionSelect.value);
        window.location.href = url.toString();
      });
    }
    const copyVersionLink = document.getElementById('copy-version-link');
    if (copyVersionLink && versionSelect) {
      copyVersionLink.addEventListener('click', async () => {
        const url = new URL(window.location.href);
        url.search = '';
        url.hash = '';
        url.searchParams.set('version', versionSelect.value);
        if (await copyText(url.toString())) {
          copyVersionLink.classList.add('is-copied');
          copyVersionLink.title = 'Copied';
          copyVersionLink.setAttribute('aria-label', 'Link copied');
          window.setTimeout(() => {
            copyVersionLink.classList.remove('is-copied');
            copyVersionLink.title = 'Copy link to this version';
            copyVersionLink.setAttribute('aria-label', 'Copy link to this version');
          }, 1400);
        } else {
          copyVersionLink.title = 'Copy failed';
          copyVersionLink.setAttribute('aria-label', 'Copy failed');
        }
      });
    }
    const installPanel = /** @type {HTMLDetailsElement|null} */ (document.getElementById('install'));
    const openInstallPanel = () => {
      if (installPanel && window.location.hash === '#install') installPanel.open = true;
    };
    document.querySelector('a[href="#install"]')?.addEventListener('click', () => {
      if (installPanel) installPanel.open = true;
    });
    window.addEventListener('hashchange', openInstallPanel);
    openInstallPanel();
    const setCopyStatus = (button, text) => {
      const original = button.textContent || 'Copy';
      button.textContent = text;
      window.setTimeout(() => {
        button.textContent = original;
      }, 1400);
    };
    document.querySelectorAll('button.copy-button').forEach((button) => {
      button.addEventListener('click', async () => {
        const code = button.closest('.code-window')?.querySelector('code');
        if (!code) return;
        const text = code.textContent || '';
        setCopyStatus(button, await copyText(text) ? 'Copied' : 'Failed');
      });
    });
  </script>
</body>
</html>
