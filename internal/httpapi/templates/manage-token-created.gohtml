<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Access Token Created</title>
  <style nonce="{{.Navigation.CSPNonce}}">
    :root { color-scheme: light; --bg: #f3f0ea; --panel: #fff; --ink: #1f2428; --muted: #66717a; --accent: #2f6f73; --line: #d9e0e2; --warn: #8a5b12; }
    {{template "manage-navigation-styles" .Navigation}}
    * { box-sizing: border-box; }
    body { margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--ink); }
    main { max-width: 1080px; margin: 0 auto; padding: 32px 20px 72px; }
    .panel { padding: 24px; border: 1px solid var(--line); border-radius: 8px; background: var(--panel); box-shadow: 0 10px 30px rgba(31,36,40,.05); }
    h1 { margin: 0 0 10px; font-size: 30px; }
    p { color: var(--muted); line-height: 1.5; }
    .warning { color: var(--warn); font-weight: 700; }
    .token { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 10px; margin: 20px 0; padding: 12px; border-radius: 6px; background: #172522; color: #eef8f4; }
    code { min-width: 0; overflow-x: auto; padding: 7px; white-space: nowrap; font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    button, .back { min-height: 40px; padding: 0 16px; border: 1px solid var(--accent); border-radius: 6px; background: var(--accent); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
    .back { display: inline-flex; align-items: center; text-decoration: none; }
  </style>
</head>
<body>
  <main>
    {{template "manage-navigation" .Navigation}}
    <section class="panel">
      <h1>{{.Kind}} token created</h1>
      <p>Team: <strong>{{.Team}}</strong> · Name: <strong>{{.Name}}</strong> · Prefix: <strong>{{.Prefix}}</strong></p>
      <p class="warning">This token is shown once. Store it now; it cannot be recovered later.</p>
      <div class="token"><code id="created-token">{{.Token}}</code><button id="copy-token" type="button">Copy</button></div>
      <a class="back" href="{{.Next}}">Back to team</a>
    </section>
  </main>
  <script nonce="{{.Navigation.CSPNonce}}">
    {{template "clipboard-script" .}}
    (() => {
      const button = /** @type {HTMLButtonElement} */ (document.getElementById('copy-token'));
      const token = /** @type {HTMLElement} */ (document.getElementById('created-token'));
      /** @type {(text: string) => Promise<boolean>} */
      const copyText = window['copyTextToClipboard'];
      const setCopyStatus = (text) => {
        const original = button.textContent || 'Copy';
        button.textContent = text;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1400);
      };
      button.addEventListener('click', async () => {
        const value = token.textContent || '';
        setCopyStatus(await copyText(value) ? 'Copied' : 'Failed');
      });
    })();
  </script>
</body>
</html>
