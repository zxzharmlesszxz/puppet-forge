{{template "layout" .}}

{{define "page-title"}}Access Token Created{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/manage-token-created.css">{{end}}

{{define "page-content"}}
<section class="panel content-panel">
  <h1>{{.Kind}} token created</h1>
  <p>Team: <strong>{{.Team}}</strong> · Name: <strong>{{.Name}}</strong> · Prefix: <strong>{{.Prefix}}</strong></p>
  <p class="warning">This token is shown once. Store it now; it cannot be recovered later.</p>
  <div class="token"><code id="created-token">{{.Token}}</code><button id="copy-token" type="button">Copy</button></div>
  <a class="back action-button" href="{{.Next}}">Back to team</a>
</section>
{{end}}

{{define "page-scripts"}}
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/clipboard.js" defer></script>
<script nonce="{{.Navigation.CSPNonce}}" src="/assets/manage-token-created.js" defer></script>
{{end}}
