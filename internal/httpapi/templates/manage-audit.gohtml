{{template "layout" .}}

{{define "page-title"}}{{.Title}}{{end}}

{{define "page-styles"}}<link rel="stylesheet" href="/assets/manage-audit.css">{{end}}

{{define "page-subtitle"}}<div class="subtitle">Persistent security events for administrative changes, publication, authentication, and module deletion. Force-delete comments are shown with their target and request ID.</div>{{end}}

{{define "page-content"}}
{{template "page-header" .}}

<section class="panel list-panel report-panel" id="audit-list" data-async-list aria-label="Security audit events">
  {{template "list-filter" .Filter}}
  {{if .Events}}<div class="table-wrap"><table>
    <thead><tr><th scope="col">When</th><th scope="col">Event</th><th scope="col">Actor</th><th scope="col">Target</th><th scope="col">Details</th></tr></thead>
    <tbody>{{range .Events}}<tr>
      <td><time datetime="{{.OccurredAt}}"><span>{{.OccurredDate}}</span><span>{{.OccurredTime}}</span></time></td>
      <td class="event"><span class="action">{{.Action}}</span><span class="result {{.Result}}">{{.Result}}</span>{{if ne .Reason "none"}}<div class="context">{{.Reason}}</div>{{end}}</td>
      <td class="actor"><strong>{{.Actor}}</strong><span>{{.AuthMethod}}</span></td>
      <td class="target"><code>{{.Target}}</code></td>
      <td class="details">
        {{if .Details}}<div class="change-summary">{{.Details}}</div>{{end}}
        {{if .Justification}}<div class="comment"><strong>Comment</strong>{{.Justification}}</div>{{end}}
        {{if and (not .Details) (not .Justification)}}<span class="context">No additional details</span>{{end}}
        <details class="technical-context"><summary>Technical context</summary><dl>
          <dt>Request</dt><dd><code>{{.RequestID}}</code></dd>
          <dt>Source</dt><dd>{{.SourceIP}}</dd>
          <dt>Auth</dt><dd>{{.AuthMethod}}</dd>
          <dt>Reason</dt><dd>{{.Reason}}</dd>
          {{if .TargetTokenID}}<dt>Target token ID</dt><dd><code>{{.TargetTokenID}}</code></dd>{{end}}
          {{if .ActorTokenID}}<dt>Actor token ID</dt><dd><code>{{.ActorTokenID}}</code></dd>{{end}}
          {{if .OIDCSubject}}<dt>OIDC subject</dt><dd><code>{{.OIDCSubject}}</code></dd>{{end}}
        </dl></details>
      </td>
    </tr>{{end}}</tbody>
  </table></div>{{else}}<div class="empty">{{if .Query}}No audit events match this filter.{{else}}No audit events have been recorded yet.{{end}}</div>{{end}}
  {{template "pagination" (paginationView .Pagination "events" "list-pagination" "Audit log pages")}}
</section>
{{end}}
